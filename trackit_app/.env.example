DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=your_jwt_secret_here
PORT=3000
NODE_ENV=development

# Required for the Admin Profile "Change Password" email OTP flow.
# Any SMTP provider works -- for Gmail, SMTP_USER is your address and
# SMTP_PASS is a 16-character Gmail App Password (not your login
# password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=your_email@gmail.com
